<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Sky -->
    <item>
        <shape>
            <gradient
                android:startColor="#81D4FA"
                android:endColor="#E1F5FE"
                android:angle="90" />
        </shape>
    </item>
    <!-- Back Hills -->
    <item android:top="400dp">
        <shape>
            <solid android:color="#43A047"/>
            <corners android:topLeftRadius="300dp" android:topRightRadius="100dp"/>
        </shape>
    </item>
    <!-- Front Hills -->
    <item android:top="550dp">
        <shape>
            <solid android:color="#2E7D32"/>
            <corners android:topLeftRadius="100dp" android:topRightRadius="400dp"/>
        </shape>
    </item>
</layer-list>